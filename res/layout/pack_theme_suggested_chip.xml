<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggested_chip_expanded_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/suggested_chip_button_padding_bottom"
    android:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/theme_pack_entry"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/suggested_chip_button_height"
        android:background="@drawable/pack_theme_suggested_chip_background"
        android:minHeight="@dimen/accessibility_min_height">

        <ImageButton
            android:id="@+id/suggested_chip_cancel_button"
            android:layout_width="@dimen/suggested_chip_cancel_button_size"
            android:layout_height="@dimen/suggested_chip_cancel_button_size"
            android:layout_margin="@dimen/suggested_chip_icon_padding"
            android:background="@drawable/cancel_icon"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/suggested_chip_text"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/suggested_chip_icon"
            android:layout_width="@dimen/suggested_chip_image_size"
            android:layout_height="@dimen/suggested_chip_image_size"
            android:layout_margin="@dimen/suggested_chip_icon_padding"
            android:background="@drawable/theme_icon"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/suggested_chip_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/suggested_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/system_primary"
            android:textSize="@dimen/suggested_chip_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/suggested_chip_cancel_button"
            app:layout_constraintStart_toEndOf="@+id/suggested_chip_icon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

