<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apply_button_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/apply_button_horizontal_padding"
    android:minHeight="@dimen/touch_target_min_height"
    android:background="@drawable/apply_button_background">

    <TextView
        android:id="@+id/apply_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apply_btn"
        android:textColor="@color/system_on_primary"
        android:layout_gravity="center"
        android:textAppearance="@style/WallpaperPicker.Preview.TextAppearance.NoAllCaps" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/apply_button_progress_indicator"
        android:layout_width="@dimen/apply_button_progress_indicator_size"
        android:layout_height="@dimen/apply_button_progress_indicator_size"
        android:layout_gravity="center"
        style="@style/CircularProgressIndicator"
        android:indeterminate="true" />
</FrameLayout>